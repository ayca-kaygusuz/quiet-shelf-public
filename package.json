{
  "name": "quiet-shelf",
  "version": "0.20.0",
  "private": true,
  "description": "A personal book, manga and comic reading library",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node pc/server.mjs",
    "test": "node scripts/check.mjs",
    "build": "node build.mjs",
    "desktop": "electron .",
    "build:windows": "node scripts/build-windows.mjs",
    "build:android": "node scripts/build-android.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "build:ios": "node scripts/build-ios.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "main": "desktop/main.mjs",
  "productName": "Quiet Shelf",
  "build": {
    "appId": "com.quietshelf.desktop",
    "productName": "Quiet Shelf",
    "copyright": "Copyright 2026 Alex (Ayca Kaygusuz)",
    "directories": {
      "output": "work/windows",
      "buildResources": "desktop/assets"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "desktop/**/*.mjs",
      "desktop/assets/icon.ico",
      "desktop/assets/icon.png",
      "src/index.html",
      "assets/Manrope-OFL.txt",
      "package.json",
      "src/*.js",
      "src/*.mjs",
      "desktop/google-client.generated.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "assets/licenses/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "executableName": "Quiet Shelf",
      "signExecutable": false
    },
    "publish": null,
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE-Quiet-Shelf.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE-Quiet-Shelf.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "assets/Manrope-OFL.txt",
        "to": "licenses/Manrope-OFL.txt"
      },
      {
        "from": "assets/licenses",
        "to": "licenses/android-compatibility"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "quiet-shelf",
      "category": "Office",
      "icon": "desktop/assets/icon.png",
      "artifactName": "Quiet-Shelf-${version}-linux-${arch}.${ext}",
      "maintainer": "Quiet Shelf contributors <contributors@example.invalid>",
      "desktop": {
        "entry": {
          "Name": "Quiet Shelf",
          "Comment": "Your personal reading library",
          "StartupWMClass": "quiet-shelf"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "compression": "xz"
    }
  },
  "author": "Alex (Ayca Kaygusuz)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ayca-kaygusuz/quiet-shelf-public",
  "desktopName": "quiet-shelf.desktop"
}
