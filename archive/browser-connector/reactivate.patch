diff --git b/connector/README.txt a/connector/README.txt
new file mode 100644
index 0000000..61e3d95
--- /dev/null
+++ a/connector/README.txt
@@ -0,0 +1,25 @@
+QUIET SHELF BROWSER CONNECTOR
+
+This connector reads public search results from the listed bookstores and returns
+selectable titles to Quiet Shelf. It does not read PC files, send browser cookies
+to Quiet Shelf, or run on unrelated websites. It briefly opens search tabs.
+If a store requests a CAPTCHA, complete it yourself and retry the search.
+It cannot guarantee access or stable page layouts at third-party stores.
+
+EDGE / CHROME
+1. Extract the ZIP inside your chosen connector folder.
+2. Open edge://extensions or chrome://extensions.
+3. Enable Developer mode, choose Load unpacked, select the extracted folder
+   containing manifest.json.
+4. Refresh http://127.0.0.1:8765. Quiet Shelf should show Browser connector connected.
+
+FIREFOX
+Use the Firefox package. Extract it in your chosen connector folder.
+Open about:debugging#/runtime/this-firefox, choose Load Temporary Add-on,
+and select manifest.json. Refresh Quiet Shelf.
+Firefox temporary add-ons must be loaded again after Firefox restarts.
+
+Use the same browser for the connector and Quiet Shelf.
+No login to Quiet Shelf, paid service, or API key is needed for the connector.
+Permissions are restricted to the local app and these named stores:
+D&R, Idefix, Amazon TR/US/UK/DE/JP, Google Books and AniList.
diff --git b/connector/background.js a/connector/background.js
new file mode 100644
index 0000000..ff7775c
--- /dev/null
+++ a/connector/background.js
@@ -0,0 +1,25 @@
+const extensionAPI=typeof browser==='object'?browser:chrome;
+const stores={google:{name:'Google Books',origin:'https://books.google.com',path:'/books?q='},anilist:{name:'AniList',origin:'https://anilist.co',path:'/search/manga?search='},dr:{name:'D&R',origin:'https://www.dr.com.tr',path:'/search?q='},idefix:{name:'İdefix',origin:'https://www.idefix.com',path:'/arama?q='},amazontr:{name:'Amazon Türkiye',origin:'https://www.amazon.com.tr',path:'/s?k='},amazonus:{name:'Amazon US',origin:'https://www.amazon.com',path:'/s?k='},amazonuk:{name:'Amazon UK',origin:'https://www.amazon.co.uk',path:'/s?k='},amazonde:{name:'Amazon Germany',origin:'https://www.amazon.de',path:'/s?k='},amazonjp:{name:'Amazon Japan',origin:'https://www.amazon.co.jp',path:'/s?k='}};
+const running=new Map();
+const pause=ms=>new Promise(r=>setTimeout(r,ms));
+function extract(source,origin){
+ const clean=s=>String(s||'').replace(/\s+/g,' ').trim();const results=[],seen=new Set();
+ function add(item){if(!item.title||!item.sourceUrl||seen.has(item.sourceUrl))return;seen.add(item.sourceUrl);results.push(item)}
+ if(source==='google'||source==='anilist'){
+ for(let link of document.querySelectorAll('a[href]')){let u;try{u=new URL(link.href,origin)}catch{continue}let valid=source==='google'?u.hostname==='books.google.com'&&u.pathname==='/books'&&/^[\w-]+$/.test(u.searchParams.get('id')||''):u.hostname==='anilist.co'&&/^\/manga\/\d+/.test(u.pathname);if(!valid)continue;let title=clean(link.querySelector('h2,h3')?.textContent||link.getAttribute('title')||link.querySelector('img')?.alt||link.textContent);if(title.length<3||/^(preview|more editions|read more|full view|limited preview|önizleme|daha fazla)$/i.test(title))continue;add({title,author:'',cover:link.querySelector('img')?.src||'',sourceUrl:source==='google'?'https://books.google.com/books?id='+encodeURIComponent(u.searchParams.get('id')):'https://anilist.co'+u.pathname,format:source==='anilist'?'Manga':'Book',recordKind:source==='anilist'?'series':'edition',language:'',connector:true});if(results.length>=12)break}
+ }else if(source.startsWith('amazon')){for(const card of document.querySelectorAll('[data-component-type="s-search-result"][data-asin]')){let asin=card.getAttribute('data-asin');if(!/^[A-Z0-9]{10}$/.test(asin))continue;let heading=card.querySelector('h2');let title=clean(heading?.innerText);if(!title)continue;let author=clean(card.querySelector('.a-row .a-size-base.a-link-normal')?.textContent||'');let img=card.querySelector('img.s-image');add({title,author,cover:img?.src||'',sourceUrl:origin+'/dp/'+asin,format:'Book',language:'',recordKind:'edition',connector:true})}}
+ else{
+  const structured=[];for(let tag of document.querySelectorAll('script[type="application/ld+json"]')){try{let j=JSON.parse(tag.textContent);structured.push(...(j['@graph']||(Array.isArray(j)?j:[j])))}catch{}}
+  const nodes=structured.flatMap(n=>n['@type']==='ItemList'?(n.itemListElement||[]).map(x=>x.item):[n]);
+  const productURL=value=>{try{let u=new URL(value,origin);return u.origin===origin&&(source==='idefix'?/-p-\d+/.test(u.pathname):/\/kitap\//i.test(u.pathname))?u.origin+u.pathname:''}catch{return ''}};
+  for(let n of nodes){if(!n||!['Book','Product'].some(t=>[n['@type']].flat().includes(t)))continue;let url=productURL(n.url||n.offers?.url);let name=v=>(Array.isArray(v)?v:[v]).filter(Boolean).map(x=>typeof x==='string'?x:x.name||'').join(', ');add({title:clean(n.name),author:clean(name(n.author)),publisher:clean(name(n.publisher)),isbn:clean(n.isbn||''),language:clean(n.inLanguage||''),cover:(Array.isArray(n.image)?n.image[0]:typeof n.image==='string'?n.image:n.image?.url)||'',sourceUrl:url,format:'Book',recordKind:'edition',connector:true})}
+  if(!results.length){for(let link of document.querySelectorAll('a[href]')){let url=productURL(link.href);if(!url)continue;let title=clean(link.querySelector('h2,h3,[class*="title"],[class*="Title"]')?.textContent||link.getAttribute('title')||link.getAttribute('aria-label')||link.querySelector('img')?.alt||link.textContent);if(title.length<3||/^(incele|satın al|sepete ekle|ürünü incele)$/i.test(title))continue;add({title,author:'',cover:link.querySelector('img')?.src||'',sourceUrl:url,language:'',format:'Book',recordKind:'edition',connector:true});if(results.length>=12)break}}
+ }
+ const blocked=!!document.querySelector('#captchacharacters,form[action*="validateCaptcha"],#challenge-running,#challenge-form')||/captcha|access denied|attention required|robot check/i.test(document.title);
+ return {results:results.slice(0,12),blocked,ready:document.readyState==='complete'};
+}
+extensionAPI.runtime.onMessage.addListener((message,sender,reply)=>{
+ if(message?.type!=='search'||!sender.tab?.id||!/^http:\/\/127\.0\.0\.1:8765\/$/.test(sender.url||'')||!stores[message.source]||typeof message.q!=='string'||message.q.trim().length<2||message.q.length>160){reply({error:'Invalid Quiet Shelf search request.'});return false}
+ const old=running.get(sender.tab.id);if(old)old.cancelled=true;const job={cancelled:false};running.set(sender.tab.id,job);const store=stores[message.source];(async()=>{let tab,keep=false;try{tab=await extensionAPI.tabs.create({url:store.origin+store.path+encodeURIComponent(message.q)+(message.source.startsWith('amazon')?'&i=stripbooks':''),active:false});for(let i=0;i<30;i++){await pause(1000);if(job.cancelled){reply({error:'Search superseded'});return}let current=await extensionAPI.tabs.get(tab.id);if(current.status!=='complete')continue;let [{result}]=await extensionAPI.scripting.executeScript({target:{tabId:tab.id},func:extract,args:[message.source,store.origin]});if(result.results.length){reply({results:result.results.map(b=>({...b,source:store.name})),source:message.source});return}if(result.blocked){keep=true;await extensionAPI.tabs.update(tab.id,{active:true});reply({error:store.name+' requires you to complete its access check in the opened tab. Then retry the search in Quiet Shelf.'});return}}
+ keep=true;reply({error:store.name+' returned no readable product results. Its search tab has been left open for inspection.'})}catch(e){reply({error:store.name+' browser search failed: '+String(e.message).slice(0,160)})}finally{if(running.get(sender.tab.id)===job)running.delete(sender.tab.id);if(tab&&!keep)try{await extensionAPI.tabs.remove(tab.id)}catch{}}})();return true;
+});
