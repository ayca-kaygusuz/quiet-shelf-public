diff --git b/connector/content.js a/connector/content.js
new file mode 100644
index 0000000..eb439d5
--- /dev/null
+++ a/connector/content.js
@@ -0,0 +1,4 @@
+function ready(){window.dispatchEvent(new CustomEvent('quiet-shelf-ready'))}
+window.addEventListener('quiet-shelf-hello',ready);
+window.addEventListener('quiet-shelf-request',event=>{let data;try{data=JSON.parse(event.detail)}catch{return;}if(!data||typeof data.id!=='string')return;chrome.runtime.sendMessage({type:'search',source:data.source,q:data.q},response=>{let error=chrome.runtime.lastError;window.dispatchEvent(new CustomEvent('quiet-shelf-response',{detail:JSON.stringify({id:data.id,...(error?{error:error.message}:response||{error:'Browser connector did not respond.'})})}))})});
+ready();
diff --git b/connector/manifest-chrome.json a/connector/manifest-chrome.json
new file mode 100644
index 0000000..8b874d0
--- /dev/null
+++ a/connector/manifest-chrome.json
@@ -0,0 +1,35 @@
+{
+  "manifest_version": 3,
+  "name": "Quiet Shelf Bookstore Connector",
+  "version": "0.6.1",
+  "description": "Returns bookstore search results to your local Quiet Shelf.",
+  "permissions": [
+    "scripting"
+  ],
+  "host_permissions": [
+    "http://127.0.0.1:8765/*",
+    "https://books.google.com/*",
+    "https://anilist.co/*",
+    "https://www.dr.com.tr/*",
+    "https://www.idefix.com/*",
+    "https://www.amazon.com.tr/*",
+    "https://www.amazon.com/*",
+    "https://www.amazon.co.uk/*",
+    "https://www.amazon.de/*",
+    "https://www.amazon.co.jp/*"
+  ],
+  "content_scripts": [
+    {
+      "matches": [
+        "http://127.0.0.1:8765/*"
+      ],
+      "js": [
+        "content.js"
+      ],
+      "run_at": "document_idle"
+    }
+  ],
+  "background": {
+    "service_worker": "background.js"
+  }
+}
\ No newline at end of file
