const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict');let listeners={},elements={},timers=[];class Event{constructor(type,init={}){this.type=type;this.detail=init.detail}}
const window={addEventListener:(name,fn)=>(listeners[name]??=[]).push(fn),dispatchEvent:event=>(listeners[event.type]||[]).forEach(fn=>fn(event))};let sent;
const ctx={window,CustomEvent:Event,URL,AbortController,console,location:{hostname:'localhost'},crypto:require('node:crypto').webcrypto,localStorage:{getItem:()=>null,setItem:()=>{}},setTimeout:fn=>{timers.push(fn);return timers.length},clearTimeout:()=>{},document:{querySelectorAll:()=>[],addEventListener:()=>{},querySelector:s=>elements[s]??={value:s==='#format'?'All formats':'',innerHTML:'',hidden:false,textContent:'',setAttribute:()=>{},addEventListener:()=>{},querySelector:()=>({disabled:false})}},fetch:()=>{throw Error('Browser-store results must not use server fetch')},chrome:{runtime:{lastError:null,sendMessage:(message,callback)=>{sent=message;callback({results:[{title:'A <Book>',author:'Author',source:'Amazon US',sourceUrl:'https://www.amazon.com/dp/B012345678',format:'Book',connector:true}]})}}}};vm.createContext(ctx);let source=fs.readFileSync('src/index.html','utf8').match(/<script>([\s\S]*)<\/script>/)[1];vm.runInContext(source,ctx);vm.runInContext(fs.readFileSync('connector/content.js','utf8'),ctx);assert.equal(elements['#connectorStatus'].textContent,'Browser connector connected');elements['#lookupSource'].value='amazonus';elements['#lookup'].value='A Book';elements['#lookupSource'].onchange();
(async()=>{await timers.shift()();assert.equal(sent.source,'amazonus');assert.equal(sent.q,'A Book');assert.equal(elements['#lookupResults'].hidden,false);assert.match(elements['#lookupResults'].innerHTML,/A &lt;Book&gt;/);await elements['#lookupResults'].onclick({target:{closest:()=>({dataset:{result:'0'}})}});assert.equal(elements['#title'].value,'A <Book>');assert.equal(elements['#editionPreview'].hidden,false);assert.equal(vm.runInContext('selectedEdition.source',ctx),'Amazon US');console.log('PASS: connector handshake, string-based browser bridge, source-scoped request, real dropdown path, escaped result titles and import into Add title without another fetch')})().catch(e=>{console.error(e);process.exitCode=1});
